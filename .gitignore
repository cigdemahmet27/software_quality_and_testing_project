# ========================
# JaCoCo Coverage (regenerated via mvn test)
# ========================
# HTML reports are regenerated, no need to track
# target/site/jacoco/ is already excluded via target/

# ========================
# Secrets / API Keys
# ========================
.env
.env.*

# ========================
# Python temp (if any helper scripts used)
# ========================
__pycache__/
*.pyc
*.pyo

# ========================
# Logs (runtime)
# ========================
*.log

# ========================
# Files outside this repo that should never leak
# ========================
# The repo root is software_quality_and_testing_project/
# Files like humaneval_java.jsonl, project PDFs, etc. 
# live outside this folder and are never seen by git.

# ========================
# Documents (PDF, TXT)
# ========================
*.pdf
# ALLOW the PDF inside the report folder to be tracked
!report/*.pdf
*.txt

